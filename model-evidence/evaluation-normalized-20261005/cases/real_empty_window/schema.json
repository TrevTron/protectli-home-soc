          },
          {
            "type": "unknown",
            "topic": "complete_visibility"
          },
          {
            "type": "unknown",
            "topic": "process_identity"
          }
        ],
        [
          {
            "type": "unknown",
            "topic": "intent"
          },
          {
            "type": "unknown",
            "topic": "complete_visibility"
          },
          {
            "type": "unknown",
            "topic": "payload"
          }
        ],
        [
          {
            "type": "unknown",
            "topic": "intent"
          },
          {
            "type": "unknown",
            "topic": "complete_visibility"
          },
          {
            "type": "unknown",
            "topic": "process_identity"
          },
          {
            "type": "unknown",
            "topic": "payload"
          }
        ]
      ]
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group_id",
          "action"
        ],
        "properties": {
          "group_id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "inspect_event",
              "check_client_process",
              "compare_baseline",
              "check_rule",
