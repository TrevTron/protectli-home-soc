              "stun_may_be_normal",
              "uid_fixture_possible",
              "sensor_reported_block",
              "change_needs_context",
              "tailscale_control_possible"
            ]
          },
          "group_id": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 3
          }
        }
      },
      "maxItems": 0
    },
    "unknown": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "topic"
        ],
        "properties": {
          "type": {
            "const": "unknown"
          },
          "topic": {
            "enum": [
              "intent",
              "process_identity",
              "payload",
              "complete_visibility"
            ]
          }
        }
      },
      "minItems": 2,
      "maxItems": 4,
      "enum": [
        [
          {
            "type": "unknown",
            "topic": "intent"
          },
          {
            "type": "unknown",
            "topic": "complete_visibility"
          }
        ],
        [
          {
            "type": "unknown",
