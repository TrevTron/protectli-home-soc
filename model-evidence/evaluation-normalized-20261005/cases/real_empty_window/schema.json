    "next_steps"
  ],
  "properties": {
    "observed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "group_id",
          "field",
          "value"
        ],
        "properties": {
          "type": {
            "const": "observed"
          },
          "group_id": {
            "type": "string"
          },
          "field": {
            "enum": [
              "count",
              "sid",
              "action",
              "severity",
              "protocol",
              "prior_count",
              "change"
            ]
          },
          "value": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          }
        }
      },
      "maxItems": 0
    },
    "inferred": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
